[Unit]
Description=tulaufa.ru minecraft control API
After=network.target
Wants=network.target

[Service]
Type=simple
User=tulaufa-mine
Group=tulaufa-mine
ExecStart=/opt/tulaufa-mine/tulaufa-mine
EnvironmentFile=/etc/tulaufa-mine/env
Restart=on-failure
RestartSec=5

# Hardening. NoNewPrivileges is deliberately absent: it would block sudo, which
# is how this service reaches mc-ctl. Everything else is tightened instead.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target

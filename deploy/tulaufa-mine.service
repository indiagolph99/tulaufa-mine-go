[Unit]
Description=tulaufa.ru minecraft control API
After=network.target
Wants=network.target

# Give up after repeated failures instead of restarting forever; a
# misconfiguration should end in a visible failed state, not a loop.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=tulaufa-mine
Group=tulaufa-mine
ExecStart=/opt/tulaufa-mine/tulaufa-mine
# Optional on purpose. A mandatory EnvironmentFile that is missing makes
# systemd refuse to spawn the process at all, reporting only "unavailable
# resources or another system error". Letting it be absent means the binary
# starts and says exactly what is wrong: "ADMIN_PASSWORD_HASH is not set".
EnvironmentFile=-/etc/tulaufa-mine/env
Restart=on-failure
RestartSec=5

# Hardening. NoNewPrivileges is deliberately absent: it would block sudo, which
# is how this service reaches mc-ctl. Everything else is tightened instead.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
